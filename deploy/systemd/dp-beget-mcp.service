[Unit]
Description=DP Beget Bridge MCP server
After=network.target dp-beget-agent.service
Requires=dp-beget-agent.service

[Service]
Type=simple
User=__DP_MCP_USER__
Group=__DP_MCP_GROUP__
WorkingDirectory=/opt/dp-beget-bridge
EnvironmentFile=/etc/dp-beget-bridge/mcp.env
ExecStart=/usr/bin/env node apps/mcp/src/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
TasksMax=128
LimitNOFILE=4096
MemoryMax=512M
MemorySwapMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dp-beget-bridge-mcp

[Install]
WantedBy=multi-user.target
