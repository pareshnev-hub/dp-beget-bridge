[Unit]
Description=DP Beget Bridge MCP server
After=network.target dp-beget-agent.service
Requires=dp-beget-agent.service

[Service]
Type=simple
User=__DP_USER__
Group=__DP_GROUP__
WorkingDirectory=/opt/dp-beget-bridge
EnvironmentFile=/etc/dp-beget-bridge/bridge.env
ExecStart=/usr/bin/env node apps/mcp/src/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dp-beget-bridge

[Install]
WantedBy=multi-user.target
