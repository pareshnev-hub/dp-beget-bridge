[Unit]
Description=DP Beget Bridge agent
After=network.target dp-beget-session-host.service
Wants=dp-beget-session-host.service

[Service]
Type=simple
User=__DP_AGENT_USER__
Group=__DP_AGENT_GROUP__
SupplementaryGroups=__DP_IPC_GROUP__
WorkingDirectory=/opt/dp-beget-bridge
EnvironmentFile=/etc/dp-beget-bridge/agent.env
ExecStart=/usr/bin/env node apps/agent/src/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dp-beget-bridge-agent __DP_ALLOWED_ROOT__

[Install]
WantedBy=multi-user.target
