DP_AGENT_HOST=127.0.0.1
DP_AGENT_PORT=8787
DP_AGENT_TOKEN=replace-with-a-long-random-token
DP_MCP_ACCESS_TOKEN=replace-with-a-different-long-random-token
DP_AGENT_URL=http://127.0.0.1:8787
DP_DATA_DIR=/var/lib/dp-beget-bridge-agent
DP_SESSION_DATA_DIR=/var/lib/dp-beget-bridge
DP_SESSION_HOST_SOCKET=/run/dp-beget-bridge/session-host.sock
DP_ALLOWED_ROOTS=/opt/beget,/var/log
DP_TMUX_SOCKET=/var/lib/dp-beget-bridge/tmux/tmux.sock
DP_MCP_HOST=127.0.0.1
DP_MCP_PORT=8788
DP_MCP_PATH=/mcp
DP_MCP_AUTH_MODE=static
# DP-012 OAuth spike runs as a separate listener/service. Never combine these
# settings with the retained Secure MCP Tunnel listener.
# DP_MCP_AUTH_MODE=oauth
# DP_MCP_PORT=8789
# DP_PUBLIC_URL=https://bridge.example.com
# DP_OAUTH_ISSUER=https://bridge.example.com
# DP_OAUTH_RESOURCE=https://bridge.example.com/mcp
# DP_OAUTH_STAGING_APPROVAL_SECRET=replace-with-a-separate-random-32-plus-character-secret
# DP_OAUTH_SCOPES=files:read
# DP_OAUTH_ALLOWED_CLIENT_IDS=https://chatgpt.com/oauth/client.json
# DP_OAUTH_TRANSACTION_TTL_MS=300000
# DP_OAUTH_CODE_TTL_MS=120000
# DP_OAUTH_ACCESS_TOKEN_TTL_MS=600000
# DP_OAUTH_CLIENT_METADATA_TIMEOUT_MS=5000
DP_TERMINAL_HISTORY_LINES=100000
DP_TERMINAL_MAX_ACTIVE=8
DP_COMMAND_WAIT_MS=10000
DP_SESSION_OUTPUT_WARN_BYTES=52428800
DP_SESSION_OUTPUT_MAX_BYTES=67108864
DP_STORAGE_MIN_FREE_BYTES=268435456
DP_FILE_UPLOAD_MAX_BYTES=536870912
DP_FILE_TRANSFER_MAX_CONCURRENT=2
DP_ATTACHMENT_FETCH_ENABLED=true
DP_ATTACHMENT_FETCH_TIMEOUT_MS=120000
DP_ATTACHMENT_MAX_BYTES=67108864
DP_ATTACHMENT_MAX_REDIRECTS=5
DP_ATTACHMENT_MAX_CONCURRENT=2
DP_LOG_LEVEL=info
DP_TELEMETRY_ENABLED=false
DP_TELEMETRY_URL=https://pareshnev.com/api/dp-beget-bridge/events
DP_TELEMETRY_HOST=127.0.0.1
DP_TELEMETRY_PORT=8790
DP_TELEMETRY_DATA_DIR=/var/lib/dp-beget-bridge-telemetry
DP_TELEMETRY_HASH_SECRET=replace-on-the-collector-only
DP_TELEMETRY_RETENTION_DAYS=90
DP_PUBLIC_URL=https://bridge.pareshnev.com
DP_SITE_URL=https://pareshnev.com/dp-beget-bridge
